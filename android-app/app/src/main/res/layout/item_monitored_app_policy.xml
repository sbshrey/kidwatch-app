<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/kw_card_surface_alt"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/kw_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPolicyAppIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_placeholder_apps" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPolicyAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/kw_on_surface" />

                <TextView
                    android:id="@+id/tvPolicyAppPackage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/kw_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPolicyAppState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_soft"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/kw_on_primary_container" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPolicyTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/monitoring_policy_track" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPolicyScreenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitoring_policy_screenshots" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPolicyFace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/monitoring_policy_face" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
