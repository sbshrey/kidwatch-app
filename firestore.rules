rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // TEMPORARY dev bypass to unblock testing.
    // Expires on 2026-04-30. After that, rules fall back to deny.
    function inDevWindow() {
      return request.time < timestamp.date(2026, 4, 30);
    }

    match /{document=**} {
      allow read, write: if isSignedIn() && inDevWindow();
    }
  }
}
